      "parameters": {
        "jsCode": "const program = $json.program || $json.data || {};\nconst required = ['summary', 'phases'];\nconst missing = required.filter((key) => !program[key]);\nreturn [{ json: { ...$json, program, outputValid: missing.length === 0, missingFields: missing, needsHumanReview: missing.length > 0 || Boolean($json.lowConfidence) } }];"
      },
